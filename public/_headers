# Cloudflare Pages response headers (https://developers.cloudflare.com/pages/configuration/headers/)

# The project's pages.dev address serves the same site as fn.lkev.in: keep it out of search
# results (preview deployments already get noindex from Cloudflare).
https://frontend-elf.pages.dev/*
  X-Robots-Tag: noindex

# Hashed build output: never changes under the same name.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin

# Files for crawlers and AI agents
/llms.txt
  Content-Type: text/markdown; charset=utf-8
  X-Robots-Tag: noindex
  Cache-Control: public, max-age=3600
/llms-full.txt
  Content-Type: text/markdown; charset=utf-8
  X-Robots-Tag: noindex
  Cache-Control: public, max-age=3600
/*.md
  Content-Type: text/markdown; charset=utf-8
  X-Robots-Tag: noindex
  Cache-Control: public, max-age=3600
/sitemap.xml
  Cache-Control: public, max-age=3600

# Social preview image
/og-image.png
  Cache-Control: public, max-age=604800
